# ── Required ────────────────────────────────────────────────────────────────

# From @BotFather. The bot only ever makes outbound calls (long polling), so this
# token does not need a webhook URL or a public host. (The one port it does open
# answers a health check and nothing else — see PORT and HEALTH_PATH below.)
TELEGRAM_BOT_TOKEN=

# Who may talk to this bot. One numeric id, or several separated by commas or
# spaces — two accounts for the same operator is the normal case. Message
# @userinfobot to get an id. There is no default: the bot refuses to start
# without at least one, because a bot with no allowlist is a bot anyone can drive.
# Automatic asks go to every id listed; a command's answer goes only to whoever
# sent it; and whoever pastes first files the brief.
TELEGRAM_OWNER_ID=

# NurXai base URL. Must match the host that holds LORE_AGENT_SECRET.
NURXAI_BASE_URL=https://nurxai.xyz

# The same value as LORE_AGENT_SECRET on NurXai. At least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LORE_AGENT_SECRET=

# ── The model that reads a pasted document ──────────────────────────────────
# Set exactly one of these. Anthropic is preferred when both are present.
ANTHROPIC_API_KEY=
# Used as a fallback when ANTHROPIC_API_KEY is empty. Same key NurXai uses.
AI_GATEWAY_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# LORE_PARSER_MODEL=claude-haiku-4-5
# LORE_PARSER_TIMEOUT_MS=45000
# LORE_STATE_FILE=./state.json
# LORE_AUTO_ASK=true
# LORE_ASK_COOLDOWN_HOURS=24
# LORE_MIN_MISSES=2
# LORE_POLL_INTERVAL_MINUTES=30

# How long a paste that has started arriving waits for its next piece before the
# bot files what it has. Telegram refuses anything over 4096 characters, so a real
# answer arrives in several messages; the timer restarts on every piece and only
# rings on silence. Raise it if you paste slowly, lower it if you want the parse
# to start sooner. /done files immediately whatever this is set to.
# LORE_PASTE_QUIET_SECONDS=10

# The HTTP listener. PORT is set for you by the host; unset means no listener at
# all, which is the right default on a machine nobody health-checks. HEALTH_PATH
# is the only path that answers — it is a secret, not a convention, because an
# uptime ping needs a URL and that URL is the whole inbound surface.
# PORT=10000
# HEALTH_PATH=/up-a-long-random-slug
